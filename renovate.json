{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>autonomouslogic/renovate-config"
  ],
  "packageRules": [
    {
      "matchDepNames": ["@anthropic-ai/claude-code"],
      "schedule": ["at any time"],
      "groupName": "claude-code"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\nENV \\w+=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
